(function(){'use strict';function hydrateStylesheetPlaceholder(link){if(link.href)return;const styleId=link.getAttribute('layout-style-id');if(!styleId)return;const href='https://default.salsalabs.org/public/styles/'+styleId+'.css';if(document.querySelector('link[rel="stylesheet"][href="'+href+'"]'))return;link.href=href;}document.querySelectorAll('link[rel="stylesheet"][layout-style-id]').forEach(hydrateStylesheetPlaceholder);const styleObserver=new MutationObserver(function(mutations){mutations.forEach(function(mutation){mutation.addedNodes.forEach(function(node){if(node.nodeType!==1)return;if(node.matches('link[rel="stylesheet"][layout-style-id]'))hydrateStylesheetPlaceholder(node);node.querySelectorAll('link[rel="stylesheet"][layout-style-id]').forEach(hydrateStylesheetPlaceholder);});});});styleObserver.observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('load',function(){window.salsaWidgetFinished=function(activityId,eventObj){const urlParams=new URLSearchParams(window.location.search);const emailToPrepopulate=urlParams.get('email');if(!emailToPrepopulate)return;function populateSalsaField(){const emailField=document.querySelector('input[type="email"]')||document.querySelector('input[name="field-contact-email"]');if(emailField){emailField.value=emailToPrepopulate;emailField.dispatchEvent(new Event('input',{bubbles:true}));emailField.dispatchEvent(new Event('change',{bubbles:true}));emailField.dispatchEvent(new Event('blur',{bubbles:true}));return true;}return false;}if(populateSalsaField())return;const observer=new MutationObserver((mutations,obs)=>{if(populateSalsaField())obs.disconnect();});observer.observe(document.body,{childList:true,subtree:true});};},false);})();;
